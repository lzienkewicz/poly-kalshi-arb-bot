# ── Trading mode ──────────────────────────────────────────────────────────────
# Set to true to enable live order placement. Defaults to paper mode.
LIVE_TRADING=false

# ── Polymarket ─────────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# ── Kalshi ────────────────────────────────────────────────────────────────────
KALSHI_API_KEY=
KALSHI_API_SECRET=
# Base URL: https://trading-api.kalshi.com/trade-api/v2  (prod)
#           https://demo-api.kalshi.co/trade-api/v2      (demo)
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Risk caps ─────────────────────────────────────────────────────────────────
MAX_TRADE_SIZE_USD=100
MAX_PORTFOLIO_EXPOSURE_USD=1000

# ── Edge thresholds ───────────────────────────────────────────────────────────
MIN_NET_EDGE_USD=0.02
# Fee rates as decimals (e.g. 0.02 = 2%)
POLYMARKET_FEE_RATE=0.02
KALSHI_FEE_RATE=0.02
# Additional slippage buffer as a fraction of notional
SLIPPAGE_BUFFER=0.005
# Stale-data penalty applied when quotes are older than STALE_QUOTE_SECONDS
STALE_QUOTE_SECONDS=30
STALE_DATA_PENALTY_USD=0.01

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
